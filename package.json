{
  "name": "pikvm-mcp-server",
  "version": "0.2.0",
  "description": "MCP server for controlling remote machines via PiKVM",
  "main": "dist/index.js",
  "bin": {
    "pikvm-mcp-server": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:hw": "npm run build && node --test --test-concurrency=1 \"test/hw/*.hw.test.mjs\""
  },
  "keywords": [
    "mcp",
    "pikvm",
    "kvm",
    "remote-control",
    "hid"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "allowScripts": {
    "sharp@0.35.5": true,
    "esbuild@0.27.2": false,
    "fsevents@2.3.3": false
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "dotenv": "^17.2.3",
    "sharp": "^0.35.5",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
