# PiKVM MCP Server Configuration

# Required: PiKVM host URL
PIKVM_HOST=https://<your-pikvm-ip>

# Required: PiKVM password
PIKVM_PASSWORD=your_password

# Optional: PiKVM username (default: admin)
PIKVM_USERNAME=admin

# Optional: Verify SSL certificates (default: false for self-signed certs)
PIKVM_VERIFY_SSL=false

# Optional: Default keyboard layout (default: en-us)
PIKVM_DEFAULT_KEYMAP=en-us

# Optional: Auto-calibration settings
# Number of sampling rounds for auto-calibration (default: 5)
PIKVM_CALIBRATION_ROUNDS=5
# Number of verification rounds after computing calibration (default: 5)
PIKVM_CALIBRATION_VERIFY_ROUNDS=5
# Delay in ms after each mouse move during calibration (default: 300, increase for slow connections)
PIKVM_CALIBRATION_MOVE_DELAY=300

# --- HTTP mode (KVM-in-a-box gateway) ---------------------------------------
# Set PIKVM_MCP_PORT to serve MCP over Streamable HTTP instead of stdio.
# The server binds all interfaces; bearer auth below is mandatory.
PIKVM_MCP_PORT=8675

# Required when PIKVM_MCP_PORT is set. Clients send it as:
#   Authorization: Bearer <token>
# Generate one with: openssl rand -hex 32
# Refuses to start in HTTP mode without it.
PIKVM_MCP_BEARER=

# 1 = arm keyboard/mouse HID tools in HTTP mode (pikvm_type, pikvm_key,
# pikvm_shortcut, pikvm_mouse_click, pikvm_calibrate, pikvm_auto_calibrate).
# Default is 0 = DISARMED: those tools return an error and no HID events are
# sent. stdio mode is never gated (local callers gate on their own side).
PIKVM_MCP_ARM_HID=0

# 1 = skip .env loading entirely. For systemd/gateway deployments that export
# env directly: a stray .env file must not win over explicitly-set vars.
# Only read from the real process environment - .env cannot enable this
# for itself.
PIKVM_MCP_NO_DOTENV=0
