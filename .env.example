# Modified 2026-10 by PLN: PIKVM_REQUEST_TIMEOUT_MS (GPL-3.0; see NOTICE).
# Modified 2026-10 by PLN: MSD upload deadlines (GPL-3.0; see NOTICE).
# PiKVM MCP Server Configuration

# Required: PiKVM host URL
PIKVM_HOST=https://<your-pikvm-ip>

# Required: PiKVM password
PIKVM_PASSWORD=your_password

# Optional: PiKVM username (default: admin)
PIKVM_USERNAME=admin

# Optional: Verify SSL certificates (default: false for self-signed certs)
PIKVM_VERIFY_SSL=false

# Optional: Default keyboard layout (default: en-us)
PIKVM_DEFAULT_KEYMAP=en-us

# Optional: abort deadline for one ordinary kvmd call, in milliseconds.
# Digits only, 1..600000 (default: 5000). 0 and non-digit strings use 5000.
# HID POSTs use a separate ceiling (print: length and delay, min 10s,
# refused above 50s; other HID: 30s).
PIKVM_REQUEST_TIMEOUT_MS=5000

# Optional: MSD upload wall clock, in milliseconds (default: 21600000, 6 hours).
# Uploads do not use PIKVM_REQUEST_TIMEOUT_MS.
PIKVM_MSD_JOB_TIMEOUT_MS=21600000

# Optional: MSD upload idle gap, in milliseconds (default: 60000).
PIKVM_MSD_IDLE_TIMEOUT_MS=60000

# Optional: Auto-calibration settings
# Number of sampling rounds for auto-calibration (default: 5)
PIKVM_CALIBRATION_ROUNDS=5
# Number of verification rounds after computing calibration (default: 5)
PIKVM_CALIBRATION_VERIFY_ROUNDS=5
# Delay in ms after each mouse move during calibration (default: 300, increase for slow connections)
PIKVM_CALIBRATION_MOVE_DELAY=300

# --- HTTP mode (KVM-in-a-box gateway) ---------------------------------------
# Uncomment PIKVM_MCP_PORT to serve MCP over Streamable HTTP instead of stdio
# (copying this example as-is must NOT flip you to HTTP mode).
# PIKVM_MCP_PORT=8675

# Bind address (default 127.0.0.1). The gateway may need a bridge gateway IP
# so a containerized Caddy can reach this instance.
# PIKVM_MCP_HOST=127.0.0.1

# Required when PIKVM_MCP_PORT is set. Clients send it as:
#   Authorization: Bearer <token>
# Generate one with: openssl rand -hex 32
# Refuses to start in HTTP mode without it.
PIKVM_MCP_BEARER=

# 1 = arm ALL keyboard/mouse HID tools in HTTP mode (pikvm_type, pikvm_key,
# pikvm_shortcut, pikvm_mouse_move, pikvm_mouse_click, pikvm_mouse_scroll,
# pikvm_calibrate, pikvm_auto_calibrate). Default 0 = DISARMED: those tools
# return an error and no HID events are sent. stdio mode is never gated
# (local callers gate on their own side).
PIKVM_MCP_ARM_HID=0

# 1 = skip .env loading entirely. For systemd/gateway deployments that export
# env directly: a stray .env file must not win over explicitly-set vars.
# Only read from the real process environment - .env cannot enable this
# for itself. Even without this flag, explicitly-set process env always wins
# over .env values (override:false); .env only fills gaps.
PIKVM_MCP_NO_DOTENV=0
