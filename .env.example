# Modified 2026-10 by PLN: stock nginx does not pre-empt the finalise window (GPL-3.0; see NOTICE).
# PiKVM MCP Server Configuration

# Required: PiKVM host URL
PIKVM_HOST=https://<your-pikvm-ip>

# Required: PiKVM password. A non-empty value wins over PIKVM_PASSWORD_FILE
# and over $CREDENTIALS_DIRECTORY/pikvm-password. An empty value is unset.
# The value is used verbatim. Only a file loses one trailing newline.
PIKVM_PASSWORD=your_password

# Optional file instead of PIKVM_PASSWORD. One trailing newline is removed.
# The target of a symlink must be a regular file. Mode looser than 0600 warns.
# PIKVM_PASSWORD_FILE=/etc/pikvm/password

# Optional: PiKVM username (default: admin)
PIKVM_USERNAME=admin

# Legacy TLS switch. Exactly "true" means PIKVM_TLS_MODE=verify when
# PIKVM_TLS_MODE is unset. Any other value, including unset, means insecure.
# insecure is the current default and logs a one-line warning. A later major
# release may change that default. When PIKVM_TLS_MODE is set, it wins.
PIKVM_VERIFY_SSL=false

# verify | pin | insecure. Unset follows PIKVM_VERIFY_SSL (see above).
# pin requires PIKVM_TLS_CERT_FILE. Obtain it with:
#   pikvm-mcp-server pin default
# --yes on that command is only for a scripted re-pin after out-of-band
# verification. A non-TTY without --yes writes nothing.
# PIKVM_TLS_MODE=pin
# PIKVM_TLS_CERT_FILE=/etc/pikvm-mcp/default.pem

# Optional: Default keyboard layout (default: en-us)
PIKVM_DEFAULT_KEYMAP=en-us

# Optional: abort deadline for one ordinary kvmd call, in milliseconds.
# Digits only, 1..600000 (default: 5000). 0 and non-digit strings use 5000.
# HID POSTs use a separate ceiling (print: length and delay, min 10s,
# refused above 50s; other HID: 30s).
PIKVM_REQUEST_TIMEOUT_MS=5000

# Optional: pikvm_screenshot preview. Integers. Empty uses 960, 600, and 70.
# A registry screenshot field overrides an omitted value. A per-call value wins.
# Quality is 1-100. Width and height are 1-10000.
PIKVM_SCREENSHOT_MAX_WIDTH=960
PIKVM_SCREENSHOT_MAX_HEIGHT=600
PIKVM_SCREENSHOT_QUALITY=70

# Optional: one OCR snapshot, in milliseconds (default: 30000).
# Digits only, 1..600000. A timeout is not retried. A pre-send
# unreachable error is retried once.
PIKVM_OCR_TIMEOUT_MS=30000

# Optional: last-resort safety cap for one MSD upload or URL download,
# in milliseconds (default: 21600000, 6 hours). Not the progress bound.
# Uploads do not use PIKVM_REQUEST_TIMEOUT_MS. Digits only. 0 uses the default.
# Clamped to 7 days (604800000).
PIKVM_MSD_JOB_TIMEOUT_MS=21600000

# Optional: MSD progress bound, in milliseconds (default: 60000).
# Covers each hash read, the upload body,
# write_remote response headers (connect timeout plus this value), and
# the write_remote stream. The upload finalise window is twice this
# value (120s by default), armed when the body has been handed to the
# socket. We cannot see when kvmd has actually read the bytes, only when
# they were handed to the socket, so the OS send buffer and the peer's
# receive window can still be draining after the body is sent. The 2×
# allows for that drain. It does not cap a phase that keeps making
# progress. PIKVM_MSD_JOB_TIMEOUT_MS stays a last-resort safety cap.
# The catalog wait uses PIKVM_MSD_READY_TIMEOUT_MS.
# Lowering this for the network also bounds local disk reads while
# hashing, so a slow or spun-down disk can fail the hash.
# Digits only. 0 uses the default. Clamped to 1 hour (3600000).
# Per kvmd's shipped nginx config, /api/msd/write does not set proxy
# timeouts. nginx's proxy_read_timeout starts only after nginx has
# finished sending the request body upstream, and client_body_timeout
# is a per-read gap on the client side, so stock nginx does not
# pre-empt the 120s finalise window.
PIKVM_MSD_IDLE_TIMEOUT_MS=60000

# Optional: how long a successful MSD write waits for the catalog, in
# milliseconds (default: 30000). Digits only. 0 uses the default.
# Clamped to 10 minutes (600000). The upload is not sent again.
PIKVM_MSD_READY_TIMEOUT_MS=30000

# Optional: Auto-calibration settings
# Number of sampling rounds for auto-calibration (default: 5)
PIKVM_CALIBRATION_ROUNDS=5
# Number of verification rounds after computing calibration (default: 5)
PIKVM_CALIBRATION_VERIFY_ROUNDS=5
# Delay in ms after each mouse move during calibration (default: 300, increase for slow connections)
PIKVM_CALIBRATION_MOVE_DELAY=300

# --- HTTP mode (KVM-in-a-box gateway) ---------------------------------------
# Uncomment PIKVM_MCP_PORT to serve MCP over Streamable HTTP instead of stdio
# (copying this example as-is must NOT flip you to HTTP mode).
# PIKVM_MCP_PORT=8675

# Bind address (default 127.0.0.1). The gateway may need a bridge gateway IP
# so a containerized Caddy can reach this instance.
# PIKVM_MCP_HOST=127.0.0.1

# Required when PIKVM_MCP_PORT is set. Clients send it as:
#   Authorization: Bearer <token>
# Generate one with: openssl rand -hex 32
# HTTP mode refuses to start until one of PIKVM_MCP_BEARER,
# PIKVM_MCP_BEARER_FILE, or CREDENTIALS_DIRECTORY/pikvm-mcp-bearer is set.
# An empty value is unset, so this line does not hide the file or the
# credential, and stdio mode still starts. A non-empty value is used
# verbatim and wins over the file. Leading or trailing whitespace is
# rejected when PIKVM_MCP_PORT is set. stdio mode does not use the bearer.
PIKVM_MCP_BEARER=

# Optional file instead of PIKVM_MCP_BEARER.
# PIKVM_MCP_BEARER_FILE=/etc/pikvm/bearer

# systemd sets this when the unit uses LoadCredential=. A missing
# pikvm-password or pikvm-mcp-bearer file here means that secret is unset.
# CREDENTIALS_DIRECTORY=/run/credentials/pikvm-mcp.service

# 1 = arm ALL keyboard/mouse HID tools in HTTP mode (pikvm_type, pikvm_key,
# pikvm_shortcut, pikvm_mouse_move, pikvm_mouse_click, pikvm_mouse_scroll,
# pikvm_calibrate, pikvm_auto_calibrate). Default 0 = DISARMED: those tools
# return an error and no HID events are sent. stdio mode is never gated
# (local callers gate on their own side).
PIKVM_MCP_ARM_HID=0

# 1 = arm MSD changes in HTTP mode. Every pikvm_msd_* tool is gated except
# the read-only allowlist (pikvm_msd_status, pikvm_msd_job). Default 0 =
# DISARMED: those tools return an error and no MSD change is sent.
# PIKVM_MCP_ARM_HID=1 does not arm MSD. stdio mode is never gated.
PIKVM_MCP_ARM_MSD=0

# Directory of images pikvm_msd_upload may read. Bare names only.
# Unset hides that tool. The path is not logged.
# PIKVM_MSD_LOCAL_DIR=/srv/iso

# Per-transfer cap in bytes (default 16 GiB). Digits only. 0 uses the default.
PIKVM_MSD_MAX_BYTES=17179869184

# Allowed upload suffixes (default .iso,.img).
PIKVM_MSD_EXTENSIONS=.iso,.img

# Comma-separated https prefixes and optional Tailscale CIDRs.
# https://images.example/iso matches that path and children.
# 100.64.0.0/10 or fd7a:115c:a1e0::/48 (or a narrower CIDR inside them)
# opts in resolved addresses in that range. A CIDR alone does not allow a URL.
# Empty hides pikvm_msd_fetch_url.
# PIKVM_MSD_URL_ALLOWLIST=https://images.example/iso,100.64.0.0/10

# 1 = allow loopback, unspecified, RFC1918, other ULA, multicast, and broadcast
# for an allowlisted host. Does not allow Tailscale/CGNAT. Never allows
# 169.254.0.0/16, fe80::/10, fd00:ec2::254, 100.100.100.100,
# 100.100.100.200, fd7a:115c:a1e0::53, or 64:ff9b:1::/48. A wrapped IPv4
# address (::/96, 64:ff9b::/96, 2002::/16) is allowed only when the inner
# IPv4 is globally public. ::ffff: stays plain IPv4. Default 0.
# PIKVM_MSD_URL_ALLOW_PRIVATE=0

# write_remote connect timeout in seconds (aiohttp sock_connect). Default 30.
# Digits only. 0 or empty uses the default. A non-numeric value uses the
# default and logs a warning. Clamped to 120. Not the job cap, and not
# clamped to the 60s idle timeout. The write_remote header window is this
# connect timeout plus PIKVM_MSD_IDLE_TIMEOUT_MS. The stream then uses the
# idle timeout alone. The catalog wait uses PIKVM_MSD_READY_TIMEOUT_MS.
# PIKVM_MSD_URL_CONNECT_TIMEOUT_SEC=30

# 1 = skip .env loading entirely. For systemd/gateway deployments that export
# env directly: a stray .env file must not win over explicitly-set vars.
# Only read from the real process environment - .env cannot enable this
# for itself. Even without this flag, explicitly-set process env always wins
# over .env values (override:false); .env only fills gaps.
PIKVM_MCP_NO_DOTENV=0
